# ===== Godot 4 =====
# Editor cache (large, regenerated on open)
.godot/

# Legacy import cache (Godot 3 - keep just in case)
.import/

# Per-user editor settings
*.tmp
*.translation

# Export presets w/ credentials
export_credentials.cfg

# Local build / export outputs
builds/
exports/
bin/
obj/

# ===== C# =====
*.csproj.user
*.suo
*.user
*.userprefs
*.pidb

# Compiled assemblies in subprojects
**/bin/
**/obj/

# ===== IDE / Editors =====
.vscode/
.vs/
.idea/
*.sln.docstates

# ===== OS =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Claude Code / dev tooling =====
# Per-user Claude config (not committed)
.claude/

# Per-user MCP server registry
.mcp.json

# clangd / compile_commands (if any C++ tooling is added later)
.clangd
compile_commands.json

# ===== Project-specific runtime / scratch =====
# Telemetry / logs
*.jsonl
*.log

# Screenshots (use references/ subfolder for committed references)
recovery_frames/
screenshots/

# Temp resolved/handover files
*.resolved

# Godot editor binary (per-user)
Godot_v*/
godot/

# Godot MCP Pro (paid product, per-user)
godot-mcp-pro-*/
godot-mcp-pro-*.zip
addons/godot_mcp/