root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.{md,svg,xml,html}]
indent_style = space
indent_size = 2

[*.{json,yml,yaml,toml}]
indent_style = space
indent_size = 2

[*.gd]
# GDScript convention is tabs, indent size 4
indent_style = tab
indent_size = 4
