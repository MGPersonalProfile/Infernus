{
    "_schema": "INFERNUS Animation Events v1.0",
    "_description": "Define per-frame events for animation clips. Claude's dispatcher will fire these at runtime.",
    "_actions": {
        "activate_hitbox": "Enable damage hitbox with given size/offset. Params: {width, height, offsetX, offsetY, duration}",
        "deactivate_hitbox": "Disable the active hitbox.",
        "spawn_particles": "Spawn particle effect. Params: {type, count, offsetX, offsetY}",
        "screen_shake": "Camera shake. Params: {intensity, duration}",
        "play_sfx": "Play a sound effect. Params: {sound, volume}",
        "add_hitstop": "Freeze frame for impact feel. Params: {duration}",
        "set_invulnerable": "Toggle player invulnerability (for dodge frames). Params: {value}",
        "apply_velocity": "Apply velocity impulse. Params: {vx, vy}"
    },

    "player": {
        "attack": {
            "frameWidth": 24,
            "frameHeight": 56,
            "totalFrames": 6,
            "events": [
                { "frame": 0, "action": "play_sfx", "params": { "sound": "sword_whoosh", "volume": 0.6 } },
                { "frame": 1, "action": "apply_velocity", "params": { "vx": 60, "vy": 0 } },
                { "frame": 2, "action": "activate_hitbox", "params": { "width": 40, "height": 48, "offsetX": 24, "offsetY": -8, "duration": 0.12 } },
                { "frame": 2, "action": "play_sfx", "params": { "sound": "sword_swing", "volume": 0.8 } },
                { "frame": 3, "action": "spawn_particles", "params": { "type": "slash_arc", "count": 4, "offsetX": 32, "offsetY": 0 } },
                { "frame": 3, "action": "deactivate_hitbox", "params": {} },
                { "frame": 5, "action": "play_sfx", "params": { "sound": "sword_return", "volume": 0.3 } }
            ]
        },
        "dash": {
            "_note": "Not a spritesheet clip, but events during dash state",
            "events": [
                { "frame": 0, "action": "set_invulnerable", "params": { "value": true } },
                { "frame": 0, "action": "spawn_particles", "params": { "type": "dash_dust", "count": 6, "offsetX": -16, "offsetY": 24 } },
                { "frame": 0, "action": "play_sfx", "params": { "sound": "dash_whoosh", "volume": 0.7 } },
                { "frame": 3, "action": "set_invulnerable", "params": { "value": false } },
                { "frame": 3, "action": "spawn_particles", "params": { "type": "dash_dust", "count": 3, "offsetX": 0, "offsetY": 24 } }
            ]
        },
        "death": {
            "frameWidth": 24,
            "frameHeight": 56,
            "totalFrames": 6,
            "events": [
                { "frame": 0, "action": "screen_shake", "params": { "intensity": 6.0, "duration": 0.4 } },
                { "frame": 0, "action": "play_sfx", "params": { "sound": "death_cry", "volume": 1.0 } },
                { "frame": 1, "action": "spawn_particles", "params": { "type": "blood_burst", "count": 12, "offsetX": 0, "offsetY": 0 } },
                { "frame": 3, "action": "spawn_particles", "params": { "type": "soul_release", "count": 5, "offsetX": 0, "offsetY": -16 } }
            ]
        },
        "parry_success": {
            "_note": "Fired when parry timing is perfect",
            "events": [
                { "frame": 0, "action": "add_hitstop", "params": { "duration": 0.12 } },
                { "frame": 0, "action": "screen_shake", "params": { "intensity": 4.0, "duration": 0.15 } },
                { "frame": 0, "action": "play_sfx", "params": { "sound": "parry_clang", "volume": 1.0 } },
                { "frame": 0, "action": "spawn_particles", "params": { "type": "spark_burst", "count": 8, "offsetX": 16, "offsetY": -8 } }
            ]
        }
    },

    "melee": {
        "attack": {
            "frameWidth": 32,
            "frameHeight": 48,
            "totalFrames": 8,
            "events": [
                { "frame": 0, "action": "play_sfx", "params": { "sound": "enemy_grunt", "volume": 0.5 } },
                { "frame": 2, "action": "activate_hitbox", "params": { "width": 36, "height": 40, "offsetX": 20, "offsetY": -4, "duration": 0.16 } },
                { "frame": 2, "action": "play_sfx", "params": { "sound": "sword_swing", "volume": 0.6 } },
                { "frame": 3, "action": "spawn_particles", "params": { "type": "slash_arc", "count": 3, "offsetX": 28, "offsetY": 0 } },
                { "frame": 3, "action": "add_hitstop", "params": { "duration": 0.06 } },
                { "frame": 5, "action": "deactivate_hitbox", "params": {} }
            ]
        },
        "on_hit": {
            "events": [
                { "frame": 0, "action": "spawn_particles", "params": { "type": "blood_splash", "count": 5, "offsetX": 0, "offsetY": -8 } },
                { "frame": 0, "action": "play_sfx", "params": { "sound": "hit_flesh", "volume": 0.7 } },
                { "frame": 0, "action": "add_hitstop", "params": { "duration": 0.04 } }
            ]
        },
        "on_death": {
            "events": [
                { "frame": 0, "action": "spawn_particles", "params": { "type": "blood_burst", "count": 8, "offsetX": 0, "offsetY": 0 } },
                { "frame": 0, "action": "spawn_particles", "params": { "type": "soul_wisps", "count": 3, "offsetX": 0, "offsetY": -12 } },
                { "frame": 0, "action": "play_sfx", "params": { "sound": "enemy_death", "volume": 0.8 } },
                { "frame": 0, "action": "screen_shake", "params": { "intensity": 2.0, "duration": 0.1 } }
            ]
        }
    },

    "ranged": {
        "attack": {
            "frameWidth": 28,
            "frameHeight": 40,
            "totalFrames": 8,
            "events": [
                { "frame": 1, "action": "play_sfx", "params": { "sound": "fire_charge", "volume": 0.5 } },
                { "frame": 1, "action": "spawn_particles", "params": { "type": "fire_gather", "count": 4, "offsetX": 12, "offsetY": -16 } },
                { "frame": 3, "action": "play_sfx", "params": { "sound": "fire_cast", "volume": 0.8 } },
                { "frame": 3, "action": "spawn_particles", "params": { "type": "fire_burst", "count": 6, "offsetX": 14, "offsetY": -12 } },
                { "frame": 3, "action": "screen_shake", "params": { "intensity": 1.5, "duration": 0.08 } }
            ]
        },
        "on_hit": {
            "events": [
                { "frame": 0, "action": "spawn_particles", "params": { "type": "blood_splash", "count": 4, "offsetX": 0, "offsetY": -6 } },
                { "frame": 0, "action": "play_sfx", "params": { "sound": "hit_flesh", "volume": 0.6 } }
            ]
        },
        "on_death": {
            "events": [
                { "frame": 0, "action": "spawn_particles", "params": { "type": "fire_explosion", "count": 10, "offsetX": 0, "offsetY": 0 } },
                { "frame": 0, "action": "play_sfx", "params": { "sound": "fire_death", "volume": 0.9 } },
                { "frame": 0, "action": "screen_shake", "params": { "intensity": 3.0, "duration": 0.15 } }
            ]
        }
    },

    "assassin": {
        "attack": {
            "frameWidth": 24,
            "frameHeight": 40,
            "totalFrames": 8,
            "events": [
                { "frame": 1, "action": "play_sfx", "params": { "sound": "dagger_whoosh", "volume": 0.4 } },
                { "frame": 1, "action": "activate_hitbox", "params": { "width": 28, "height": 32, "offsetX": 16, "offsetY": -4, "duration": 0.20 } },
                { "frame": 2, "action": "spawn_particles", "params": { "type": "poison_trail", "count": 4, "offsetX": 20, "offsetY": 0 } },
                { "frame": 2, "action": "play_sfx", "params": { "sound": "dagger_slash", "volume": 0.7 } },
                { "frame": 3, "action": "spawn_particles", "params": { "type": "slash_cross", "count": 6, "offsetX": 16, "offsetY": -4 } },
                { "frame": 3, "action": "add_hitstop", "params": { "duration": 0.03 } },
                { "frame": 5, "action": "deactivate_hitbox", "params": {} }
            ]
        },
        "on_hit": {
            "events": [
                { "frame": 0, "action": "spawn_particles", "params": { "type": "poison_blood", "count": 4, "offsetX": 0, "offsetY": -6 } },
                { "frame": 0, "action": "play_sfx", "params": { "sound": "hit_light", "volume": 0.5 } }
            ]
        },
        "on_death": {
            "events": [
                { "frame": 0, "action": "spawn_particles", "params": { "type": "shadow_dissolve", "count": 8, "offsetX": 0, "offsetY": 0 } },
                { "frame": 0, "action": "play_sfx", "params": { "sound": "shadow_death", "volume": 0.7 } }
            ]
        }
    },

    "tank": {
        "attack": {
            "frameWidth": 56,
            "frameHeight": 64,
            "totalFrames": 8,
            "events": [
                { "frame": 0, "action": "play_sfx", "params": { "sound": "brute_roar", "volume": 0.8 } },
                { "frame": 1, "action": "play_sfx", "params": { "sound": "mace_raise", "volume": 0.6 } },
                { "frame": 2, "action": "activate_hitbox", "params": { "width": 56, "height": 56, "offsetX": 20, "offsetY": -8, "duration": 0.20 } },
                { "frame": 2, "action": "play_sfx", "params": { "sound": "mace_slam", "volume": 1.0 } },
                { "frame": 2, "action": "screen_shake", "params": { "intensity": 8.0, "duration": 0.3 } },
                { "frame": 3, "action": "spawn_particles", "params": { "type": "ground_crack", "count": 10, "offsetX": 24, "offsetY": 32 } },
                { "frame": 3, "action": "spawn_particles", "params": { "type": "dust_cloud", "count": 8, "offsetX": 20, "offsetY": 28 } },
                { "frame": 3, "action": "add_hitstop", "params": { "duration": 0.10 } },
                { "frame": 5, "action": "deactivate_hitbox", "params": {} }
            ]
        },
        "on_hit": {
            "events": [
                { "frame": 0, "action": "spawn_particles", "params": { "type": "armor_spark", "count": 3, "offsetX": 0, "offsetY": -12 } },
                { "frame": 0, "action": "play_sfx", "params": { "sound": "hit_armor", "volume": 0.8 } },
                { "frame": 0, "action": "add_hitstop", "params": { "duration": 0.06 } }
            ]
        },
        "on_death": {
            "events": [
                { "frame": 0, "action": "screen_shake", "params": { "intensity": 6.0, "duration": 0.4 } },
                { "frame": 0, "action": "spawn_particles", "params": { "type": "armor_shatter", "count": 12, "offsetX": 0, "offsetY": 0 } },
                { "frame": 0, "action": "spawn_particles", "params": { "type": "blood_burst", "count": 8, "offsetX": 0, "offsetY": -8 } },
                { "frame": 0, "action": "play_sfx", "params": { "sound": "heavy_death", "volume": 1.0 } }
            ]
        }
    },

    "bomber": {
        "attack": {
            "frameWidth": 32,
            "frameHeight": 32,
            "totalFrames": 8,
            "events": [
                { "frame": 0, "action": "play_sfx", "params": { "sound": "bomb_fuse", "volume": 0.5 } },
                { "frame": 1, "action": "play_sfx", "params": { "sound": "maniac_giggle", "volume": 0.6 } },
                { "frame": 3, "action": "play_sfx", "params": { "sound": "bomb_throw", "volume": 0.7 } },
                { "frame": 3, "action": "spawn_particles", "params": { "type": "fuse_sparks", "count": 4, "offsetX": 16, "offsetY": -8 } }
            ]
        },
        "on_hit": {
            "events": [
                { "frame": 0, "action": "spawn_particles", "params": { "type": "blood_splash", "count": 4, "offsetX": 0, "offsetY": -4 } },
                { "frame": 0, "action": "play_sfx", "params": { "sound": "hit_flesh", "volume": 0.6 } }
            ]
        },
        "on_death": {
            "_note": "Bomber explodes on death!",
            "events": [
                { "frame": 0, "action": "screen_shake", "params": { "intensity": 10.0, "duration": 0.5 } },
                { "frame": 0, "action": "spawn_particles", "params": { "type": "explosion", "count": 16, "offsetX": 0, "offsetY": 0 } },
                { "frame": 0, "action": "spawn_particles", "params": { "type": "fire_debris", "count": 8, "offsetX": 0, "offsetY": -8 } },
                { "frame": 0, "action": "play_sfx", "params": { "sound": "explosion_big", "volume": 1.0 } },
                { "frame": 0, "action": "add_hitstop", "params": { "duration": 0.12 } }
            ]
        }
    },

    "minotaur": {
        "slam": {
            "totalFrames": 6,
            "events": [
                { "frame": 0, "action": "play_sfx", "params": { "sound": "boss_roar", "volume": 1.0 } },
                { "frame": 1, "action": "screen_shake", "params": { "intensity": 3.0, "duration": 0.2 } },
                { "frame": 2, "action": "activate_hitbox", "params": { "width": 80, "height": 64, "offsetX": 0, "offsetY": 0, "duration": 0.25 } },
                { "frame": 2, "action": "play_sfx", "params": { "sound": "ground_slam", "volume": 1.0 } },
                { "frame": 2, "action": "screen_shake", "params": { "intensity": 12.0, "duration": 0.5 } },
                { "frame": 3, "action": "spawn_particles", "params": { "type": "shockwave", "count": 16, "offsetX": 0, "offsetY": 0 } },
                { "frame": 3, "action": "spawn_particles", "params": { "type": "ground_crack", "count": 12, "offsetX": 0, "offsetY": 24 } },
                { "frame": 3, "action": "add_hitstop", "params": { "duration": 0.15 } },
                { "frame": 5, "action": "deactivate_hitbox", "params": {} }
            ]
        },
        "charge": {
            "totalFrames": 6,
            "events": [
                { "frame": 0, "action": "play_sfx", "params": { "sound": "boss_charge_roar", "volume": 1.0 } },
                { "frame": 0, "action": "spawn_particles", "params": { "type": "dust_trail", "count": 4, "offsetX": -24, "offsetY": 24 } },
                { "frame": 2, "action": "activate_hitbox", "params": { "width": 64, "height": 56, "offsetX": 16, "offsetY": -4, "duration": 0.30 } },
                { "frame": 2, "action": "screen_shake", "params": { "intensity": 4.0, "duration": 0.3 } },
                { "frame": 3, "action": "spawn_particles", "params": { "type": "dust_trail", "count": 6, "offsetX": -20, "offsetY": 24 } },
                { "frame": 5, "action": "deactivate_hitbox", "params": {} }
            ]
        },
        "on_hit": {
            "events": [
                { "frame": 0, "action": "spawn_particles", "params": { "type": "armor_spark", "count": 6, "offsetX": 0, "offsetY": -16 } },
                { "frame": 0, "action": "play_sfx", "params": { "sound": "hit_heavy_armor", "volume": 0.9 } },
                { "frame": 0, "action": "add_hitstop", "params": { "duration": 0.08 } }
            ]
        },
        "on_death": {
            "events": [
                { "frame": 0, "action": "screen_shake", "params": { "intensity": 15.0, "duration": 0.8 } },
                { "frame": 0, "action": "add_hitstop", "params": { "duration": 0.20 } },
                { "frame": 0, "action": "spawn_particles", "params": { "type": "blood_burst", "count": 20, "offsetX": 0, "offsetY": 0 } },
                { "frame": 0, "action": "spawn_particles", "params": { "type": "soul_release", "count": 8, "offsetX": 0, "offsetY": -24 } },
                { "frame": 0, "action": "play_sfx", "params": { "sound": "boss_death_roar", "volume": 1.0 } }
            ]
        }
    }
}
